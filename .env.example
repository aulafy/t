# Supabase (server only; never expose the service role key to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# PostgreSQL connection string (use Supabase's transaction pooler on Vercel)
SUPABASE_DB_URL=postgresql://postgres.project:password@host:6543/postgres?sslmode=require

# Single owner used outside ChatGPT Sites. Protect the Vercel deployment.
EXTRACLARO_OWNER_ID=owner
EXTRACLARO_OWNER_EMAIL=you@example.com
